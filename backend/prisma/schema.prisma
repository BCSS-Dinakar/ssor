generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  loginId                String                  @unique
  passwordHash           String
  role                   String
  status                 String                  @default("pending")
  createdAt              DateTime                @default(now())
  distCode               String?
  candidateVerifications CandidateVerification[]
  organizationProfile    OrganizationProfile?
  policeProfile          PoliceProfile?
  supportTickets         SupportTicket[]
  auditLogs              SystemAuditLog[]
  district               District?               @relation(fields: [distCode], references: [distCode])

  @@index([role])
  @@index([distCode])
}

model SystemAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PoliceProfile {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique
  name           String
  badgeId        String?
  rank           String?
  empId          String?
  department     String?
  wing           String?
  jurisdiction   String?
  joiningDate    String?
  email          String?
  mobile         String?
  altPhone       String?
  station        String?
  district       String?
  state          String?
  country        String?
  clearanceLevel String?
  docsMediaIds   Int[]
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrganizationProfile {
  id                     Int     @id @default(autoincrement())
  userId                 Int     @unique
  orgName                String
  orgType                String
  parentOrg              String?
  department             String?
  jurisdiction           String?
  country                String
  state                  String
  district               String
  city                   String
  address                String
  pinCode                String
  officialEmail          String
  officialPhone          String
  altPhone               String?
  website                String?
  adminName              String
  designation            String
  empId                  String
  adminEmail             String
  mobile                 String
  authLetterMediaId      Int?
  govCertMediaId         Int?
  supportingDocsMediaIds Int[]
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateVerification {
  id               Int       @id @default(autoincrement())
  organizationId   Int
  orgName          String
  orgType          String
  role             String
  candidateName    String
  dob              DateTime
  fatherName       String?
  phone            String
  consent          Boolean
  aadharNumber     String?
  address          String?
  candidateMediaId Int?
  consentMediaId   Int?
  status           String    @default("pending")
  policeFeedback   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  distCode         String?
  district         District? @relation(fields: [distCode], references: [distCode])
  organization     User      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([distCode])
}

model SupportTicket {
  id             Int             @id @default(autoincrement())
  ticketNumber   String          @unique @default(cuid())
  organizationId Int
  subject        String
  category       String
  priority       String          @default("Medium")
  reference      String?
  status         String          @default("Open")
  assignee       String?         @default("Unassigned")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   User            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]
}

model TicketMessage {
  id         Int           @id @default(autoincrement())
  ticketId   Int
  senderName String
  senderRole String
  text       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// Central registry of every file stored in MinIO. Other tables reference a row
/// here by its `id` (stored in their document columns) instead of holding a raw
/// object key or URL. Signed URLs are generated on demand from `objectKey` and
/// are never persisted.
model Media {
  id           Int      @id @default(autoincrement())
  bucketName   String
  objectKey    String   @unique
  originalName String
  fileType     String?
  fileSize     Int?
  category     String?
  store        String   @default("minio")
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([store])
}

model ssor_kb {
  id            Int     @id @default(autoincrement())
  act_name      String
  section_code  String
  tier          String
  severity_rank Int
  description   String?

  @@unique([act_name, section_code])
}

model RiskTierDefinition {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  category    String
  description String
  nature      String
  retention   String
  colorClass  String   @default("bg-slate-600")
  defaultRank Int      @default(50)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model District {
  distCode   String                  @id
  distName   String
  stateCode  String?
  isActive   Boolean                 @default(true)
  clearances CandidateVerification[]
  users      User[]
}
